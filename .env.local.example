# Copy to .env.local and fill in. Never commit the filled-in file.
#
# Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle at build
# time. Never put a secret behind that prefix, and remember that changing one
# requires a rebuild, not just a restart.

# ---------------------------------------------------------------------------
# Supabase — Project Settings → API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Bypasses row-level security. Used in exactly one route (account deletion,
# which must remove an auth.users row) and the reminder cron.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ---------------------------------------------------------------------------
# Canonical origin. Feeds sitemap.xml, robots.txt and OAuth redirects.
# A local build produces a sitemap advertising localhost, which is valid,
# returns 200, and is silently invisible to search engines.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.notestify.com

# ---------------------------------------------------------------------------
# Google Gemini — https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key

# ---------------------------------------------------------------------------
# Google Drive import (optional — the feature hides itself when unset)
#
# A separate OAuth client from the one Supabase uses for Google sign-in, so
# its secret can be rotated without breaking login. Request the drive.file
# scope only. Redirect URI: <site>/api/drive/callback
# ---------------------------------------------------------------------------
GOOGLE_DRIVE_CLIENT_ID=your_drive_client_id.apps.googleusercontent.com
GOOGLE_DRIVE_CLIENT_SECRET=your_drive_client_secret

# 32 bytes, base64. Encrypts Drive refresh tokens before they reach Postgres.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DRIVE_TOKEN_KEY=your_base64_32_byte_key

# Public by necessity — the Picker reads both in the browser. Restrict the API
# key by HTTP referrer. The app ID is your Google Cloud project NUMBER.
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=your_picker_api_key
NEXT_PUBLIC_GOOGLE_APP_ID=your_google_cloud_project_number

# ---------------------------------------------------------------------------
# Reminder emails (optional — sending is skipped when unset)
# ---------------------------------------------------------------------------
RESEND_API_KEY=your_resend_api_key
REMINDER_FROM_EMAIL=Notestify <reminders@yourdomain.com>

# Bearer token Vercel Cron sends to /api/cron/reminders. The route fails closed
# without it: unset means 503, wrong means 404. Never leave it blank in
# production — that endpoint triggers a send to every opted-in user.
CRON_SECRET=a_long_random_string

# ---------------------------------------------------------------------------
# Cloudflare Turnstile (optional)
#
# Only the site key lives here. The secret key is configured in the Supabase
# dashboard under Authentication → Attack Protection, because Supabase is what
# verifies the token, not this app.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
